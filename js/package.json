{
  "name": "web2md-client",
  "version": "0.1.0",
  "description": "TypeScript client for the Web2MD API: web pages to clean Markdown and heading-aware RAG chunks.",
  "license": "MIT",
  "author": "Kanav Singla",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "markdown",
    "rag",
    "llm",
    "web-scraping",
    "chunking",
    "html-to-markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanavsingla28/web2md-clients.git",
    "directory": "js"
  },
  "homepage": "https://rapidapi.com/kanavsingla28/api/web2md-webpage-to-markdown-rag-chunks",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "WEB2MD_LIVE=1 vitest run test/live.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
